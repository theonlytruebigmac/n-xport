root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# rustfmt's default, enforced in CI by `cargo fmt --check`
[*.rs]
indent_style = space
indent_size = 4

# Markdown uses trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
