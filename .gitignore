# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/

# Rust/Tauri build artifacts
src-tauri/target/
src-tauri/gen/schemas/

# seed demo data (anything local in scripts/ stays untracked, except the release helper)
/scripts/*
!/scripts/bump-version.sh

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.*.local
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.sw?
*~

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Debug files
*.pdb

# TypeScript build info
*.tsbuildinfo

# Lint cache
.eslintcache

# Tauri signing keys and certificates (NEVER commit these!)
*.key
*.key.pub
*.pem
*.p12
*.pfx

# API tokens and saved credentials. The opt-in live tests read a JWT from a file; keep such
# files outside the repository, and these patterns are a backstop if one lands inside it.
*.jwt
*.token
credentials.json
credentials.vault.json

# Temporary files
*.tmp
*.temp
.cache/

# Test coverage and rustfmt backups
coverage/
*.rs.bk

# Sensitive Data Export
nc_export/
