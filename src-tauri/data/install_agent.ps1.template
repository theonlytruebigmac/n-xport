#requires -Version 5.1

<#
N-central Windows agent installer (__ORG_UNIT_TYPE__)

Generated by N-xport. The install logic is adapted from the N-central Customer Installer
Generator sample script written by Morgan Rourke (https://github.com/MorganR99).

N-ABLE SAMPLE SCRIPT DISCLAIMER
This script is provided for informational and convenience purposes only. It is
not an N-able supported product. Review and test it in a controlled environment
before production use. Use is at your own risk.

SECURITY NOTICE
This file contains an N-central registration token in plain text.
Store and transmit it securely. Delete it when deployment is complete. Do not
attach it to tickets, paste it into chat, or commit it to source control.
#>

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$NcentralServer = '__SERVER__'
$CustomerId = '__CUSTOMER_ID__'
$CustomerName = '__CUSTOMER_NAME__'
$RegistrationToken = '__REGISTRATION_TOKEN__'
$DownloadUrl = $NcentralServer + '/download/current/winnt/N-central/WindowsAgentSetup.exe'
$InstallerPath = Join-Path $env:TEMP 'WindowsAgentSetup.exe'

try {
    $currentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($currentIdentity)
    if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
        throw 'Run this script from an elevated PowerShell session.'
    }

    Write-Host ('Customer: {0} [{1}]' -f $CustomerName, $CustomerId)
    Write-Host 'Downloading the current N-central Windows agent...'
    Invoke-WebRequest -Uri $DownloadUrl -OutFile $InstallerPath -UseBasicParsing

    $installerArguments = '/s /v" /qn CUSTOMERID={0} CUSTOMERSPECIFIC=1 REGISTRATION_TOKEN={1} SERVERPROTOCOL=HTTPS SERVERADDRESS={2} SERVERPORT=443"' -f $CustomerId, $RegistrationToken, ([Uri]$NcentralServer).Host

    Write-Host 'Installing the N-central Windows agent...'
    $process = Start-Process -FilePath $InstallerPath -ArgumentList $installerArguments -Wait -PassThru

    if ($process.ExitCode -notin 0, 3010) {
        throw ('Installer exited with code {0}.' -f $process.ExitCode)
    }

    if ($process.ExitCode -eq 3010) {
        Write-Host 'Installation completed. A restart is required.' -ForegroundColor Yellow
    }
    else {
        Write-Host 'Installation completed successfully.' -ForegroundColor Green
    }
}
catch {
    Write-Error $_.Exception.Message
    exit 1
}
finally {
    if (Test-Path -LiteralPath $InstallerPath) {
        Remove-Item -LiteralPath $InstallerPath -Force -ErrorAction SilentlyContinue
    }
}
